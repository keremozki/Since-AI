ANTHROPIC_API_KEY=
# AI calls stop when this many US dollars have been spent.
BUDGET_USD=4.00
# offline (default): no network; AI requests are saved under ship-data/ai/pending and replayed once answered
#   (see docs/ai-offline.md). api: the real Claude API. record: the real API, and every answer is saved for replay.
#   To use the app with a key, set AI_MODE=record.
AI_MODE=offline
